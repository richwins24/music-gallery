      },
      {
        "time": 165.3,
        "text": "謝謝你 讓我看見幸福"
      },
      {
        "time": 169.7,
        "text": "原來努力本身就是禮物"
      },
      {
        "time": 174.1,
        "text": "在這片曾經揮灑汗水的土地"
      },
      {
        "time": 178.5,
        "text": "我們寫下 最珍貴的回憶"
      },
      {
        "time": 182.8,
        "text": "如果時間能夠慢一點"
      },
      {
        "time": 187.2,
        "text": "我想再看看熟悉的操場"
      },
      {
        "time": 191.6,
        "text": "再聽一次遠遠傳來的聲響"
      },
      {
        "time": 195.9,
        "text": "再把這一刻 好好收藏"
      },
      {
        "time": 200.3,
        "text": "因為我們都曾在這裡"
      },
      {
        "time": 204.7,
        "text": "認真地追逐自己的夢想"
      },
      {
        "time": 209.0,
        "text": "而那些一起努力的日子"
      },
      {
        "time": 213.4,
        "text": "早已成為 生命中的光"
      },
      {
        "time": 217.8,
        "text": "謝謝你 陪我走過這段路"
      },
      {
        "time": 222.2,
        "text": "讓青春有了最美的溫度"
      },
      {
        "time": 226.5,
        "text": "無論明天我們身在何處"
      },
      {
        "time": 230.9,
        "text": "都別忘了 曾經努力的自己"
      },
      {
        "time": 235.3,
        "text": "謝謝你 讓這段時光停駐"
      },
      {
        "time": 239.6,
        "text": "讓每個平凡瞬間變得珍貴"
      },
      {
        "time": 244.0,
        "text": "當有一天我們再次回顧"
      },
      {
        "time": 248.4,
        "text": "會微笑著說 青春真美"
      },
      {
        "time": 252.8,
        "text": "陽光依然 灑落在操場"
      },
      {
        "time": 257.1,
        "text": "我們帶著回憶 走向遠方"
      },
      {
        "time": 261.5,
        "text": "那些一起走過的青春"
      },
      {
        "time": 265.9,
        "text": "永遠 留在心上"
      }
    ]
  },

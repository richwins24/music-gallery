[
  {
    "time": 8.0,
    "text": "清晨的陽光 落在肩上"
  },
  {
    "time": 13.0,
    "text": "熟悉的操場 還有熟悉的模樣"
  },
  {
    "time": 18.0,
    "text": "曾經的我們 帶着一點迷茫"
  },
  {
    "time": 23.0,
    "text": "如今已學會勇敢面對遠方"
  },
  {
    "time": 28.0,
    "text": "那些留下的汗 那些笑聲"
  },
  {
    "time": 33.0,
    "text": "那些一起走過的青春"
  },
  {
    "time": 38.0,
    "text": "原來平凡的每一個十分"
  },
  {
    "time": 43.0,
    "text": "都在悄悄留下青春的刻痕"
  },
  {
    "time": 48.0,
    "text": "也許我們不會永遠站在一起"
  },
  {
    "time": 53.0,
    "text": "但這段回憶會留在心底"
  },
  {
    "time": 58.0,
    "text": "每一次努力 每一次鼓勵"
  },
  {
    "time": 63.0,
    "text": "都讓明天的自己更加堅定"
  },
  {
    "time": 68.0,
    "text": "謝謝你陪我走過這段路"
  },
  {
    "time": 73.0,
    "text": "讓平凡的日子有了溫度"
  },
  {
    "time": 78.0,
    "text": "就算未來我們各自奔赴"
  },
  {
    "time": 83.0,
    "text": "這份感動我會一直記住"
  },
  {
    "time": 88.0,
    "text": "謝謝你讓我看見幸福"
  },
  {
    "time": 93.0,
    "text": "原來努力本身就是禮物"
  },
  {
    "time": 98.0,
    "text": "在這片曾經揮灑汗水的土地"
  },
  {
    "time": 103.0,
    "text": "我們寫下 最珍貴的回憶"
  },
  {
    "time": 126.0,
    "text": "看着身旁熟悉的小臉"
  },
  {
    "time": 131.0,
    "text": "想起那些一起努力的昨天"
  },
  {
    "time": 136.0,
    "text": "不管成績最後會是怎樣"
  },
  {
    "time": 141.0,
    "text": "我們都曾為自己的目標發光"
  },
  {
    "time": 146.0,
    "text": "跌倒的時候 有人伸出手"
  },
  {
    "time": 151.0,
    "text": "疲憊的時候 有人陪着走"
  },
  {
    "time": 156.0,
    "text": "那些看似平凡的小小溫柔"
  },
  {
    "time": 161.0,
    "text": "成了我們心中最深的感動"
  },
  {
    "time": 166.0,
    "text": "也許有一天我們各奔東西"
  },
  {
    "time": 171.0,
    "text": "走向不同的城市和風景"
  },
  {
    "time": 176.0,
    "text": "但曾經並肩的那些聲音"
  },
  {
    "time": 181.0,
    "text": "會成為心中最溫暖的光影"
  },
  {
    "time": 186.0,
    "text": "謝謝你陪我走過這段路"
  },
  {
    "time": 191.0,
    "text": "讓平凡的日子有了溫度"
  },
  {
    "time": 196.0,
    "text": "就算未來我們各自奔赴"
  },
  {
    "time": 201.0,
    "text": "這份感動我會一直記住"
  },
  {
    "time": 206.0,
    "text": "謝謝你讓我看見幸福"
  },
  {
    "time": 211.0,
    "text": "原來努力本身就是禮物"
  },
  {
    "time": 216.0,
    "text": "在這片曾經揮灑汗水的土地"
  },
  {
    "time": 221.0,
    "text": "我們寫下 最珍貴的回憶"
  },
  {
    "time": 228.0,
    "text": "如果時間能夠慢一點"
  },
  {
    "time": 233.0,
    "text": "我想再看看熟悉的操場"
  },
  {
    "time": 238.0,
    "text": "再聽一次遠遠傳來的鈴聲"
  },
  {
    "time": 243.0,
    "text": "再把這一刻好好收藏"
  },
  {
    "time": 248.0,
    "text": "因為我們都曾在這裡"
  },
  {
    "time": 253.0,
    "text": "認真的追逐自己的夢想"
  },
  {
    "time": 258.0,
    "text": "而那些一起努力的日子"
  },
  {
    "time": 263.0,
    "text": "早已成為生命中的光"
  },
  {
    "time": 268.0,
    "text": "謝謝你陪我走過這段路"
  },
  {
    "time": 273.0,
    "text": "讓青春有了最美的溫度"
  },
  {
    "time": 278.0,
    "text": "不論明天我們身在何處"
  },
  {
    "time": 283.0,
    "text": "都別忘了曾經努力的自己"
  },
  {
    "time": 288.0,
    "text": "謝謝你讓這段時光停駐"
  },
  {
    "time": 293.0,
    "text": "讓每個平凡瞬間變得珍貴"
  },
  {
    "time": 298.0,
    "text": "當有一天我們再次回顧"
  },
  {
    "time": 303.0,
    "text": "會微笑着說 青春真美"
  },
  {
    "time": 313.0,
    "text": "陽光依然灑落在操場"
  },
  {
    "time": 318.0,
    "text": "我們帶着回憶走向遠方"
  },
  {
    "time": 323.0,
    "text": "那些一起走過的青春"
  },
  {
    "time": 328.0,
    "text": "永遠留在心上"

[
  {
    "time": 0.0,
    "text": "青"
  },
  {
    "time": 16.92,
    "text": "春的我在肩上熟悉的操場"
  },
  {
    "time": 21.4,
    "text": "還有熟悉的模樣"
  },
  {
    "time": 23.32,
    "text": "曾經的帶著一點迷惘"
  },
  {
    "time": 27.4,
    "text": "如今已學會勇敢變段遠方"
  },
  {
    "time": 30.7,
    "text": "那些流過的汗那些笑聲"
  },
  {
    "time": 34.4,
    "text": "那些一起走過的青春"
  },
  {
    "time": 37.86,
    "text": "原來平凡的每一個時分"
  },
  {
    "time": 42.1,
    "text": "都在悄悄留下青春的刻痕願"
  },
  {
    "time": 47.98,
    "text": "站在一起回憶會留在心底"
  },
  {
    "time": 52.8,
    "text": "每一次努力每一次孤獨"
  },
  {
    "time": 56.84,
    "text": "都讓明天的自己更加堅定"
  },
  {
    "time": 60.21,
    "text": "也顯你陪我走過這本路"
  },
  {
    "time": 64.0,
    "text": "讓平凡的日子有了溫度"
  },
  {
    "time": 67.98,
    "text": "就算未來我各自奔赴"
  },
  {
    "time": 71.62,
    "text": "這份感動我會一直記住"
  },
  {
    "time": 74.36,
    "text": "也顯你堅信服原來"
  },
  {
    "time": 79.42,
    "text": "就是"
  },
  {
    "time": 82.27,
    "text": "在這片曾經揮灑含水的土"
  },
  {
    "time": 86.83,
    "text": "寫下陪著回憶"
  },
  {
    "time": 112.74,
    "text": "那些一切努力的昨天"
  },
  {
    "time": 116.73,
    "text": "記憶最後回憶是怎樣"
  },
  {
    "time": 119.83,
    "text": "都曾為自己的目標發"
  },
  {
    "time": 123.3,
    "text": "來到的時候有人"
  },
  {
    "time": 125.44,
    "text": "伸出手疲憊的時候有人"
  },
  {
    "time": 128.62,
    "text": "陪著走那些看似"
  },
  {
    "time": 131.91,
    "text": "平凡的小小溫柔成了心中"
  },
  {
    "time": 135.87,
    "text": "最深的感動也許有一天"
  },
  {
    "time": 139.94,
    "text": "各奔東西走向不同的城市"
  },
  {
    "time": 143.78,
    "text": "和风景但曾经冰箭的那些"
  },
  {
    "time": 147.79,
    "text": "声音会成为心中最温暖"
  },
  {
    "time": 152.64,
    "text": "的线你陪我走过这段路"
  },
  {
    "time": 156.33,
    "text": "让平凡的宇宙有了温就算"
  },
  {
    "time": 160.83,
    "text": "未来我各自奔赴这份感动"
  },
  {
    "time": 164.97,
    "text": "我会一直记住写写"
  },
  {
    "time": 169.59,
    "text": "信"
  },
  {
    "time": 171.84,
    "text": "声带"
  },
  {
    "time": 174.93,
    "text": "着片曾经挥洒汗水的涂地"
  },
  {
    "time": 178.42,
    "text": "我们写下一整個"
  },
  {
    "time": 186.38,
    "text": "時間能夠"
  },
  {
    "time": 189.61,
    "text": "想再看看熟悉的操場"
  },
  {
    "time": 193.11,
    "text": "再聽一次遠遠傳來的聲響"
  },
  {
    "time": 196.97,
    "text": "再把刻好好收藏"
  },
  {
    "time": 200.41,
    "text": "因為都曾在這裡"
  },
  {
    "time": 204.47,
    "text": "認真的追逐"
  },
  {
    "time": 205.71,
    "text": "自己的夢想而那些"
  },
  {
    "time": 208.82,
    "text": "一起努力的日子"
  },
  {
    "time": 211.76,
    "text": "早已成為生命中"
  },
  {
    "time": 215.25,
    "text": "謝謝你給我走過這段路"
  },
  {
    "time": 219.29,
    "text": "像青春有最美的温度"
  },
  {
    "time": 223.79,
    "text": "天晚深在何处都别忘了"
  },
  {
    "time": 227.75,
    "text": "曾经努力的自己时"
  },
  {
    "time": 231.5,
    "text": "段时光停住凡时再珍贵"
  },
  {
    "time": 236.84,
    "text": "一天我们再次回笑着说"
  },
  {
    "time": 251.02,
    "text": "早就带着回忆走向远方"
  },
  {
    "time": 256.42,
    "text": "那些一起走过的青春在"
  }
]

{
  "audio": "song-03.mp3",
  "duration": 277.224,
  "timeUnit": "seconds",
  "subtitles": [
    {
      "id": 1,
      "start": 21.0,
      "end": 28.63,
      "text": "晚風輕輕吹過你的髮梢"
    },
    {
      "id": 2,
      "start": 28.75,
      "end": 36.38,
      "text": "月光落在你微笑的嘴角"
    },
    {
      "id": 3,
      "start": 36.5,
      "end": 44.13,
      "text": "你問我星星為什麼閃耀"
    },
    {
      "id": 4,
      "start": 44.25,
      "end": 51.88,
      "text": "我說大概是想讓你看得到"
    },
    {
      "id": 5,
      "start": 52.0,
      "end": 56.38,
      "text": "街燈陪著我們慢慢走"
    },
    {
      "id": 6,
      "start": 56.5,
      "end": 60.88,
      "text": "影子在身後牽著手"
    },
    {
      "id": 7,
      "start": 61.0,
      "end": 65.38,
      "text": "如果時間能停在這一秒"
    },
    {
      "id": 8,
      "start": 65.5,
      "end": 69.88,
      "text": "我想把整個世界都忘掉"
    },
    {
      "id": 9,
      "start": 70.0,
      "end": 74.38,
      "text": "你靠近的時候"
    },
    {
      "id": 10,
      "start": 74.5,
      "end": 78.88,
      "text": "連呼吸都變得溫柔"
    },
    {
      "id": 11,
      "start": 79.0,
      "end": 83.38,
      "text": "原來最美的宇宙"
    },
    {
      "id": 12,
      "start": 83.5,
      "end": 87.88,
      "text": "是你望向我的眼眸"
    },
    {
      "id": 13,
      "start": 88.0,
      "end": 92.88,
      "text": "我想把星星都送給你"
    },
    {
      "id": 14,
      "start": 93.0,
      "end": 97.88,
      "text": "把整片夜空寫成詩句"
    },
    {
      "id": 15,
      "start": 98.0,
      "end": 102.88,
      "text": "讓每一道光都落在你心底"
    },
    {
      "id": 16,
      "start": 103.0,
      "end": 107.88,
      "text": "告訴你我有多麼喜歡你"
    },
    {
      "id": 17,
      "start": 108.0,
      "end": 112.88,
      "text": "我想把明天都送給你"
    },
    {
      "id": 18,
      "start": 113.0,
      "end": 117.88,
      "text": "把每個日落都留給你"
    },
    {
      "id": 19,
      "start": 118.0,
      "end": 122.88,
      "text": "如果愛有一個最美的定義"
    },
    {
      "id": 20,
      "start": 123.0,
      "end": 127.88,
      "text": "就是往後每一天都有你在我身邊"
    },
    {
      "id": 21,
      "start": 128.0,
      "end": 132.26,
      "text": "你說以後想去看海"
    },
    {
      "id": 22,
      "start": 132.38,
      "end": 136.63,
      "text": "看雲朵慢慢飄向人海"
    },
    {
      "id": 23,
      "start": 136.75,
      "end": 141.0,
      "text": "我已經開始想像那畫面"
    },
    {
      "id": 24,
      "start": 141.12,
      "end": 145.38,
      "text": "你笑著回頭叫我的名字"
    },
    {
      "id": 25,
      "start": 145.5,
      "end": 149.76,
      "text": "想陪你看四季更替"
    },
    {
      "id": 26,
      "start": 149.88,
      "end": 154.13,
      "text": "想收藏你每個小脾氣"
    },
    {
      "id": 27,
      "start": 154.25,
      "end": 158.5,
      "text": "不需要多麼盛大的約定"
    },
    {
      "id": 28,
      "start": 158.62,
      "end": 162.88,
      "text": "只想把平凡過成最美風景"
    },
    {
      "id": 29,
      "start": 163.0,
      "end": 167.38,
      "text": "你牽起我的手"
    },
    {
      "id": 30,
      "start": 167.5,
      "end": 171.88,
      "text": "世界忽然有了節奏"
    },
    {
      "id": 31,
      "start": 172.0,
      "end": 176.38,
      "text": "原來心動的理由"
    },
    {
      "id": 32,
      "start": 176.5,
      "end": 180.88,
      "text": "只是因為那個人是你"
    },
    {
      "id": 33,
      "start": 181.0,
      "end": 185.26,
      "text": "我想把星星都送給你"
    },
    {
      "id": 34,
      "start": 185.38,
      "end": 189.63,
      "text": "把整片夜空寫成詩句"
    },
    {
      "id": 35,
      "start": 189.75,
      "end": 194.0,
      "text": "讓每一道光都落在你心底"
    },
    {
      "id": 36,
      "start": 194.12,
      "end": 198.38,
      "text": "告訴你我有多麼喜歡你"
    },
    {
      "id": 37,
      "start": 198.5,
      "end": 202.76,
      "text": "我想把明天都送給你"
    },
    {
      "id": 38,
      "start": 202.88,
      "end": 207.13,
      "text": "把每個日落都留給你"
    },
    {
      "id": 39,
      "start": 207.25,
      "end": 211.5,
      "text": "如果愛有一個最美的定義"
    },
    {
      "id": 40,
      "start": 211.62,
      "end": 215.88,
      "text": "就是往後每一天都有你在我身邊"
    },
    {
      "id": 41,
      "start": 216.0,
      "end": 219.38,
      "text": "如果有一天星光暗去"
    },
    {
      "id": 42,
      "start": 219.5,
      "end": 222.88,
      "text": "如果世界不再那麼美麗"
    },
    {
      "id": 43,
      "start": 223.0,
      "end": 226.38,
      "text": "我還是會握緊你的手心"
    },
    {
      "id": 44,
      "start": 226.5,
      "end": 229.88,
      "text": "因為有你就有了勇氣"
    },
    {
      "id": 45,
      "start": 230.0,
      "end": 233.38,
      "text": "不必每天都像電影"
    },
    {
      "id": 46,
      "start": 233.5,
      "end": 236.88,
      "text": "不必每一句話都動聽"
    },
    {
      "id": 47,
      "start": 237.0,
      "end": 240.38,
      "text": "只要當你轉身尋找我時"
    },
    {
      "id": 48,
      "start": 240.5,
      "end": 243.88,
      "text": "我一直都在這裡"
    },
    {
      "id": 49,
      "start": 244.0,
      "end": 246.26,
      "text": "我想把星星都送給你"
    },
    {
      "id": 50,
      "start": 246.38,
      "end": 248.63,
      "text": "把所有溫柔寫進回憶"
    },
    {
      "id": 51,
      "start": 248.75,
      "end": 251.0,
      "text": "讓往後每個平凡的四季"
    },
    {
      "id": 52,
      "start": 251.12,
      "end": 253.38,
      "text": "都有我們相愛的痕跡"
    },
    {
      "id": 53,
      "start": 253.5,
      "end": 255.76,
      "text": "我想把一生唱給你聽"
    },
    {
      "id": 54,
      "start": 255.88,
      "end": 258.13,
      "text": "讓每個音符都是約定"
    },
    {
      "id": 55,
      "start": 258.25,
      "end": 260.5,
      "text": "如果這世界只能許一個願"
    },
    {
      "id": 56,
      "start": 260.62,
      "end": 262.88,
      "text": "我希望歲月很長而你一直在我身旁"
    },
    {
      "id": 57,
      "start": 263.0,
      "end": 265.55,
      "text": "晚風還在輕輕吹"
    },
    {
      "id": 58,
      "start": 265.67,
      "end": 268.21,
      "text": "星星依然閃著光輝"
    },
    {
      "id": 59,
      "start": 268.33,
      "end": 270.88,
      "text": "我最浪漫的心願"
    },
    {
      "id": 60,
      "start": 271.0,
      "end": 270.88,
      "text": "就是明天醒來"
    },
    {
      "id": 61,
      "start": 271,
      "end": 275,
      "text": "還能看見你"
    }
  ]
}
